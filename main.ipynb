    "# Align downstream cells with the dataset prepared in cell 2.\n",
    "EXTRACT_DIR = DATASET_ROOT\n",
    "print(\"Using dataset root:\", EXTRACT_DIR)\n",
    "print(\"JSON files:\", len(list(EXTRACT_DIR.rglob(\"*.json\"))))\n",
