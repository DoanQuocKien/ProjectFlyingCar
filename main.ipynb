    "        cv2.putText(img, ID_TO_CLASS[s[\"class_id\"]], (x1, max(15, y1 - 5)), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 50, 50), 2)\n",
    "        plt.subplot(2, 3, i)\n",
