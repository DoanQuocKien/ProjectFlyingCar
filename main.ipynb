    "def box_iou_xyxy(a, b):\n",
    "    # a, b: (..., 4) in normalized xyxy\n",
    "    ax1, ay1, ax2, ay2 = a[..., 0], a[..., 1], a[..., 2], a[..., 3]\n",
    "    bx1, by1, bx2, by2 = b[..., 0], b[..., 1], b[..., 2], b[..., 3]\n",
    "\n",
    "    inter_x1 = torch.maximum(ax1, bx1)\n",
    "    inter_y1 = torch.maximum(ay1, by1)\n",
    "    inter_x2 = torch.minimum(ax2, bx2)\n",
    "    inter_y2 = torch.minimum(ay2, by2)\n",
    "\n",
    "    inter_w = torch.clamp(inter_x2 - inter_x1, min=0)\n",
    "    inter_h = torch.clamp(inter_y2 - inter_y1, min=0)\n",
    "    inter = inter_w * inter_h\n",
    "\n",
    "    area_a = torch.clamp(ax2 - ax1, min=0) * torch.clamp(ay2 - ay1, min=0)\n",
    "    area_b = torch.clamp(bx2 - bx1, min=0) * torch.clamp(by2 - by1, min=0)\n",
    "\n",
    "    union = area_a + area_b - inter + 1e-7\n",
    "    return inter / union\n",
    "\n",
    "\n",
    "def detection_loss(cls_logits, pred_box, pred_obj, gt_label, gt_box, gt_obj,\n",
    "                   w_cls=1.0, w_box=5.0, w_obj=1.0):\n",
    "    cls_loss = F.cross_entropy(cls_logits, gt_label)\n",
    "    box_loss = F.smooth_l1_loss(pred_box, gt_box)\n",
    "    obj_loss = F.binary_cross_entropy(pred_obj, gt_obj)\n",
    "    loss = w_cls * cls_loss + w_box * box_loss + w_obj * obj_loss\n",
    "    return loss, cls_loss.item(), box_loss.item(), obj_loss.item()\n",
    "\n",
    "\n",
    "def train_one_epoch(model, loader, optimizer):\n",
    "    model.train()\n",
    "    running = 0.0\n",
    "    for batch in tqdm(loader, leave=False):\n",
    "        x = batch[\"image\"].to(device)\n",
    "        yb = batch[\"bbox\"].to(device)\n",
    "        yl = batch[\"label\"].to(device)\n",
    "        yo = batch[\"objectness\"].to(device)\n",
    "\n",
    "        optimizer.zero_grad()\n",
    "        cls_logits, pred_box, pred_obj = model(x)\n",
    "        loss, _, _, _ = detection_loss(cls_logits, pred_box, pred_obj, yl, yb, yo)\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "        running += loss.item() * x.size(0)\n",
    "\n",
    "    return running / max(1, len(loader.dataset))\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def evaluate_model(model, loader):\n",
    "    model.eval()\n",
    "\n",
    "    gt_labels = []\n",
    "    pred_labels = []\n",
    "    ious = []\n",
    "\n",
    "    all_lat_ms = []\n",
    "\n",
    "    for batch in tqdm(loader, leave=False):\n",
    "        x = batch[\"image\"].to(device)\n",
    "        yb = batch[\"bbox\"].to(device)\n",
    "        yl = batch[\"label\"].to(device)\n",
    "\n",
    "        if device.type == \"cuda\":\n",
    "            torch.cuda.synchronize()\n",
    "        t0 = time.perf_counter()\n",
    "        cls_logits, pred_box, pred_obj = model(x)\n",
    "        if device.type == \"cuda\":\n",
    "            torch.cuda.synchronize()\n",
    "        t1 = time.perf_counter()\n",
    "\n",
    "        batch_ms = (t1 - t0) * 1000.0\n",
    "        per_image_ms = batch_ms / x.size(0)\n",
    "        all_lat_ms.extend([per_image_ms] * x.size(0))\n",
    "\n",
    "        pred_cls = torch.argmax(cls_logits, dim=1)\n",
    "        iou = box_iou_xyxy(pred_box, yb)\n",
    "\n",
    "        gt_labels.extend(yl.cpu().numpy().tolist())\n",
    "        pred_labels.extend(pred_cls.cpu().numpy().tolist())\n",
    "        ious.extend(iou.cpu().numpy().tolist())\n",
    "\n",
    "    acc = accuracy_score(gt_labels, pred_labels)\n",
    "    prec, rec, f1, _ = precision_recall_fscore_support(gt_labels, pred_labels, average=\"macro\", zero_division=0)\n",
    "    mean_iou = float(np.mean(ious)) if len(ious) else 0.0\n",
    "\n",
    "    # proxy AP@0.5: class must match AND IoU >= 0.5\n",
    "    tp = 0\n",
    "    for g, p, iou in zip(gt_labels, pred_labels, ious):\n",
    "        if g == p and iou >= 0.5:\n",
    "            tp += 1\n",
    "    ap50_proxy = tp / max(1, len(gt_labels))\n",
    "\n",
    "    return {\n",
    "        \"accuracy\": acc,\n",
    "        \"precision_macro\": prec,\n",
    "        \"recall_macro\": rec,\n",
    "        \"f1_macro\": f1,\n",
    "        \"mean_iou\": mean_iou,\n",
    "        \"ap50_proxy\": ap50_proxy,\n",
    "        \"latency_mean_ms\": float(np.mean(all_lat_ms)),\n",
    "        \"latency_p95_ms\": float(np.percentile(all_lat_ms, 95)) if len(all_lat_ms) else 0.0,\n",
    "    }\n",
    "\n",
    "\n",
    "def fit_model(model, train_loader, val_loader, epochs=8, lr=1e-3):\n",
    "    optimizer = torch.optim.Adam(model.parameters(), lr=lr)\n",
    "    history = []\n",
    "\n",
    "    for ep in range(1, epochs + 1):\n",
    "        train_loss = train_one_epoch(model, train_loader, optimizer)\n",
    "        val_metrics = evaluate_model(model, val_loader)\n",
    "        row = {\"epoch\": ep, \"train_loss\": train_loss, **val_metrics}\n",
    "        history.append(row)\n",
    "        print(f\"Epoch {ep:02d} | loss={train_loss:.4f} | val_acc={val_metrics['accuracy']:.4f} | val_p95={val_metrics['latency_p95_ms']:.2f} ms\")\n",
    "\n",
    "    return pd.DataFrame(history)"
   ]
  },
