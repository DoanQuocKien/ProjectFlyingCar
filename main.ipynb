    "class ConvBlock(nn.Module):\n",
    "    def __init__(self, in_ch, out_ch, k=3, s=1, p=1):\n",
    "        super().__init__()\n",
    "        self.block = nn.Sequential(\n",
    "            nn.Conv2d(in_ch, out_ch, kernel_size=k, stride=s, padding=p, bias=False),\n",
    "            nn.BatchNorm2d(out_ch),\n",
    "            nn.ReLU(inplace=True),\n",
    "        )\n",
    "\n",
    "    def forward(self, x):\n",
    "        return self.block(x)\n",
    "\n",
    "\n",
    "class TinyDetector(nn.Module):\n",
    "    def __init__(self, num_classes):\n",
    "        super().__init__()\n",
    "        self.backbone = nn.Sequential(\n",
    "            ConvBlock(3, 16),\n",
    "            nn.MaxPool2d(2),\n",
    "            ConvBlock(16, 32),\n",
    "            nn.MaxPool2d(2),\n",
    "            ConvBlock(32, 64),\n",
    "            nn.MaxPool2d(2),\n",
    "            ConvBlock(64, 128),\n",
    "            nn.AdaptiveAvgPool2d((1, 1)),\n",
    "        )\n",
    "        self.fc = nn.Sequential(\n",
    "            nn.Flatten(),\n",
    "            nn.Linear(128, 128),\n",
    "            nn.ReLU(inplace=True),\n",
    "        )\n",
    "        self.cls_head = nn.Linear(128, num_classes)\n",
    "        self.box_head = nn.Linear(128, 4)\n",
    "        self.obj_head = nn.Linear(128, 1)\n",
    "\n",
    "    def forward(self, x):\n",
    "        feat = self.backbone(x)\n",
    "        z = self.fc(feat)\n",
    "        cls_logits = self.cls_head(z)\n",
    "        box = torch.sigmoid(self.box_head(z))\n",
    "        obj = torch.sigmoid(self.obj_head(z)).squeeze(1)\n",
    "        return cls_logits, box, obj\n",
    "\n",
    "\n",
    "class SmallDetector(nn.Module):\n",
    "    def __init__(self, num_classes):\n",
    "        super().__init__()\n",
    "        self.backbone = nn.Sequential(\n",
    "            ConvBlock(3, 24),\n",
    "            ConvBlock(24, 24),\n",
    "            nn.MaxPool2d(2),\n",
    "            ConvBlock(24, 48),\n",
    "            ConvBlock(48, 48),\n",
    "            nn.MaxPool2d(2),\n",
    "            ConvBlock(48, 96),\n",
    "            ConvBlock(96, 96),\n",
    "            nn.MaxPool2d(2),\n",
    "            ConvBlock(96, 160),\n",
    "            nn.AdaptiveAvgPool2d((1, 1)),\n",
    "        )\n",
    "        self.fc = nn.Sequential(\n",
    "            nn.Flatten(),\n",
    "            nn.Linear(160, 256),\n",
    "            nn.ReLU(inplace=True),\n",
    "            nn.Dropout(0.2),\n",
    "        )\n",
    "        self.cls_head = nn.Linear(256, num_classes)\n",
    "        self.box_head = nn.Linear(256, 4)\n",
    "        self.obj_head = nn.Linear(256, 1)\n",
    "\n",
    "    def forward(self, x):\n",
    "        feat = self.backbone(x)\n",
    "        z = self.fc(feat)\n",
    "        cls_logits = self.cls_head(z)\n",
    "        box = torch.sigmoid(self.box_head(z))\n",
    "        obj = torch.sigmoid(self.obj_head(z)).squeeze(1)\n",
    "        return cls_logits, box, obj\n",
    "\n",
    "\n",
    "def count_params(model):\n",
    "    return sum(p.numel() for p in model.parameters() if p.requires_grad)\n",
    "\n",
    "\n",
    "tiny = TinyDetector(num_classes=len(TARGET_CLASSES)).to(device)\n",
    "small = SmallDetector(num_classes=len(TARGET_CLASSES)).to(device)\n",
    "\n",
    "print(\"Tiny params:\", count_params(tiny))\n",
    "print(\"Small params:\", count_params(small))"
   ]
  },
