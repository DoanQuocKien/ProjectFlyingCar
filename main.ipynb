    "TARGET_CLASSES = [\"one\", \"peace\", \"three\", \"four\", \"fist\"]\n",
    "CLASS_TO_ID = {c: i for i, c in enumerate(TARGET_CLASSES)}\n",
    "ID_TO_CLASS = {i: c for c, i in CLASS_TO_ID.items()}\n",
    "\n",
    "IMG_EXTS = {\".jpg\", \".jpeg\", \".png\", \".bmp\", \".webp\"}\n",
    "\n",
    "\n",
    "def find_json_files(root: Path):\n",
    "    return [p for p in root.rglob(\"*.json\") if p.is_file()]\n",
    "\n",
    "\n",
    "def find_image_file(root: Path, rel_or_name: str):\n",
    "    p = Path(rel_or_name)\n",
    "    candidates = []\n",
    "    if p.suffix.lower() in IMG_EXTS:\n",
    "        candidates.append(root / p)\n",
    "    else:\n",
    "        for ext in IMG_EXTS:\n",
    "            candidates.append(root / f\"{rel_or_name}{ext}\")\n",
    "    for c in candidates:\n",
    "        if c.exists():\n",
    "            return c\n",
    "    # fallback by filename search\n",
    "    name = p.name\n",
    "    hits = list(root.rglob(name))\n",
    "    return hits[0] if hits else None\n",
    "\n",
    "\n",
    "def xywh_to_xyxy(box, w, h, normalized=True):\n",
    "    x, y, bw, bh = box\n",
    "    if normalized:\n",
    "        x *= w\n",
    "        y *= h\n",
    "        bw *= w\n",
    "        bh *= h\n",
    "    x1 = max(0.0, x)\n",
    "    y1 = max(0.0, y)\n",
    "    x2 = min(float(w - 1), x + bw)\n",
    "    y2 = min(float(h - 1), y + bh)\n",
    "    return [x1, y1, x2, y2]\n",
    "\n",
    "\n",
    "def parse_hagrid_like_annotations(dataset_root: Path, target_classes):\n",
    "    \"\"\"Return list of records: {image_path, bbox_xyxy, class_id}.\n",
    "\n",
    "    This parser supports common formats encountered in HaGRID exports:\n",
    "    - dict keyed by image id/path with values containing labels + bboxes\n",
    "    - COCO-like {images, annotations, categories}\n",
    "    - list of records with direct fields\n",
    "    \"\"\"\n",
    "    records = []\n",
    "    json_files = find_json_files(dataset_root)\n",
    "    print(f\"Found {len(json_files)} json files\")\n",
    "\n",
    "    for jf in tqdm(json_files, desc=\"Parsing annotations\"):\n",
    "        try:\n",
    "            data = json.loads(jf.read_text(encoding=\"utf-8\"))\n",
    "        except Exception:\n",
    "            continue\n",
    "\n",
    "        # Case A: COCO style\n",
    "        if isinstance(data, dict) and {\"images\", \"annotations\", \"categories\"}.issubset(data.keys()):\n",
    "            id_to_name = {c[\"id\"]: c[\"name\"] for c in data.get(\"categories\", []) if \"id\" in c and \"name\" in c}\n",
    "            img_map = {im[\"id\"]: im for im in data.get(\"images\", []) if \"id\" in im}\n",
    "            for ann in data.get(\"annotations\", []):\n",
    "                cat = id_to_name.get(ann.get(\"category_id\"))\n",
    "                if cat not in target_classes:\n",
    "                    continue\n",
    "                im = img_map.get(ann.get(\"image_id\"))\n",
    "                if im is None:\n",
    "                    continue\n",
    "                file_name = im.get(\"file_name\", \"\")\n",
    "                img_path = find_image_file(dataset_root, file_name)\n",
    "                if img_path is None:\n",
    "                    continue\n",
    "                img = cv2.imread(str(img_path))\n",
    "                if img is None:\n",
    "                    continue\n",
    "                h, w = img.shape[:2]\n",
    "                box = ann.get(\"bbox\", None)\n",
    "                if box is None:\n",
    "                    continue\n",
    "                x1, y1, x2, y2 = xywh_to_xyxy(box, w, h, normalized=False)\n",
    "                records.append({\n",
    "                    \"image_path\": str(img_path),\n",
    "                    \"bbox_xyxy\": [x1, y1, x2, y2],\n",
    "                    \"class_id\": CLASS_TO_ID[cat],\n",
    "                })\n",
    "            continue\n",
    "\n",
    "        # Case B: dict keyed by image names\n",
    "        if isinstance(data, dict):\n",
    "            for k, v in data.items():\n",
    "                if not isinstance(v, dict):\n",
    "                    continue\n",
    "                labels = v.get(\"labels\") or v.get(\"label\") or []\n",
    "                bboxes = v.get(\"bboxes\") or v.get(\"bbox\") or []\n",
    "\n",
    "                if isinstance(labels, str):\n",
    "                    labels = [labels]\n",
    "                if isinstance(bboxes, dict):\n",
    "                    bboxes = [bboxes]\n",
    "                if len(labels) == 0 or len(bboxes) == 0:\n",
    "                    continue\n",
    "\n",
    "                img_path = find_image_file(dataset_root, k)\n",
    "                if img_path is None:\n",
    "                    continue\n",
    "                img = cv2.imread(str(img_path))\n",
    "                if img is None:\n",
    "                    continue\n",
    "                h, w = img.shape[:2]\n",
    "\n",
    "                for lab, box in zip(labels, bboxes):\n",
    "                    if lab not in target_classes:\n",
    "                        continue\n",
    "                    if isinstance(box, dict):\n",
    "                        box = [box.get(\"x\", 0), box.get(\"y\", 0), box.get(\"w\", box.get(\"width\", 0)), box.get(\"h\", box.get(\"height\", 0))]\n",
    "                    if not isinstance(box, (list, tuple)) or len(box) < 4:\n",
    "                        continue\n",
    "\n",
    "                    normalized = max(box[:4]) <= 1.5\n",
    "                    x1, y1, x2, y2 = xywh_to_xyxy(box[:4], w, h, normalized=normalized)\n",
    "                    records.append({\n",
    "                        \"image_path\": str(img_path),\n",
    "                        \"bbox_xyxy\": [x1, y1, x2, y2],\n",
    "                        \"class_id\": CLASS_TO_ID[lab],\n",
    "                    })\n",
    "            continue\n",
    "\n",
    "        # Case C: list of records\n",
    "        if isinstance(data, list):\n",
    "            for item in data:\n",
    "                if not isinstance(item, dict):\n",
    "                    continue\n",
    "                lab = item.get(\"label\") or item.get(\"class\") or item.get(\"category\")\n",
    "                if lab not in target_classes:\n",
    "                    continue\n",
    "                file_name = item.get(\"image\") or item.get(\"image_path\") or item.get(\"file_name\")\n",
    "                box = item.get(\"bbox\") or item.get(\"bboxes\")\n",
    "                if file_name is None or box is None:\n",
    "                    continue\n",
    "                if isinstance(box, list) and len(box) > 0 and isinstance(box[0], (list, tuple, dict)):\n",
    "                    box = box[0]\n",
    "                if isinstance(box, dict):\n",
    "                    box = [box.get(\"x\", 0), box.get(\"y\", 0), box.get(\"w\", box.get(\"width\", 0)), box.get(\"h\", box.get(\"height\", 0))]\n",
    "                img_path = find_image_file(dataset_root, str(file_name))\n",
    "                if img_path is None:\n",
    "                    continue\n",
    "                img = cv2.imread(str(img_path))\n",
    "                if img is None:\n",
    "                    continue\n",
    "                h, w = img.shape[:2]\n",
    "                normalized = max(box[:4]) <= 1.5\n",
    "                x1, y1, x2, y2 = xywh_to_xyxy(box[:4], w, h, normalized=normalized)\n",
    "                records.append({\n",
    "                    \"image_path\": str(img_path),\n",
    "                    \"bbox_xyxy\": [x1, y1, x2, y2],\n",
    "                    \"class_id\": CLASS_TO_ID[lab],\n",
    "                })\n",
    "\n",
    "    return records\n",
    "\n",
    "\n",
    "records = parse_hagrid_like_annotations(EXTRACT_DIR, TARGET_CLASSES)\n",
    "print(\"Parsed records:\", len(records))\n",
    "if len(records) == 0:\n",
    "    print(\"No samples parsed. Check dataset structure and annotation schema in downloaded HaGRID files.\")"
   ]
  },
