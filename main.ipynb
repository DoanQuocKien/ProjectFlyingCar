    "# Final benchmark on test set\n",
    "results = []\n",
    "\n",
    "if len(test_ds) == 0:\n",
    "    print(\"No test set samples.\")\n",
    "else:\n",
    "    for name, model in [(\"TinyDetector\", tiny), (\"SmallDetector\", small)]:\n",
    "        metrics = evaluate_model(model, test_loader)\n",
    "        results.append({\"model\": name, **metrics})\n",
    "\n",
    "    results_df = pd.DataFrame(results)\n",
    "    display(results_df.sort_values([\"accuracy\", \"ap50_proxy\"], ascending=False))\n",
    "\n",
