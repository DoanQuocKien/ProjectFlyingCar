    "# Standalone one-time dataset setup (minimal dependencies)\n",
    "import os\n",
    "import json\n",
    "import time\n",
    "import hashlib\n",
    "import subprocess\n",
    "import zipfile\n",
    "import shutil\n",
    "from pathlib import Path\n",
    "\n",
    "REPO_ROOT = Path(\".\").resolve()\n",
    "DATA_ROOT = REPO_ROOT / \"data\"\n",
    "DATA_ROOT.mkdir(parents=True, exist_ok=True)\n",
    "REGISTRY_PATH = REPO_ROOT / \"dataset_registry.json\"\n",
    "\n",
    "KAGGLE_DATASET = \"innominate817/hagrid-sample-30k-384p\"\n",
    "RAW_DATASET_ROOT = DATA_ROOT / \"hagrid-sample-30k-384p\"\n",
    "FILTERED_DATASET_ROOT = DATA_ROOT / \"hagrid-sample-30k-384p-5class\"\n",
    "DATASET_ROOT = FILTERED_DATASET_ROOT\n",
    "EXTRACT_DIR = DATASET_ROOT\n",
    "KEEP_CLASSES = [\"one\", \"peace\", \"three\", \"four\", \"fist\"]\n",
    "KAGGLE_AUTH_CANDIDATES = [\n",
    "    Path.home() / \".kaggle\" / \"access_token.txt\",\n",
    "    Path.home() / \".kaggle\" / \"kaggle.json\",\n",
    "]\n",
    "\n",
    "\n",
    "def load_registry(path: Path):\n",
    "    if path.exists():\n",
    "        try:\n",
    "            return json.loads(path.read_text(encoding=\"utf-8\"))\n",
    "        except Exception:\n",
    "            pass\n",
    "    return {\"datasets\": {}}\n",
    "\n",
    "\n",
    "def save_registry(path: Path, registry: dict):\n",
    "    path.write_text(json.dumps(registry, indent=2), encoding=\"utf-8\")\n",
    "\n",
    "\n",
    "def sha1_of_file(path: Path | None):\n",
    "    if path is None or not path.exists():\n",
    "        return None\n",
    "    h = hashlib.sha1()\n",
    "    with path.open(\"rb\") as f:\n",
    "        for chunk in iter(lambda: f.read(1 << 20), b\"\"):\n",
    "            h.update(chunk)\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "def ensure_kaggle_installed():\n",
    "    probe = subprocess.run([\"python\", \"-m\", \"pip\", \"show\", \"kaggle\"], capture_output=True, text=True)\n",
    "    if probe.returncode == 0:\n",
    "        print(\"kaggle package already available in notebook kernel\")\n",
    "        return\n",
    "\n",
    "    print(\"Installing kaggle package...\")\n",
    "    subprocess.check_call([\"python\", \"-m\", \"pip\", \"install\", \"-q\", \"kaggle\"])\n",
    "    print(\"kaggle package installed\")\n",
    "\n",
    "\n",
    "def detect_auth_file():\n",
    "    for candidate in KAGGLE_AUTH_CANDIDATES:\n",
    "        if candidate.exists():\n",
    "            return candidate\n",
    "    return None\n",
    "\n",
    "\n",
    "def find_existing_dataset_root(base_dir: Path):\n",
    "    if FILTERED_DATASET_ROOT.exists() and any(FILTERED_DATASET_ROOT.rglob(\"*.json\")) and any(FILTERED_DATASET_ROOT.rglob(\"*.jpg\")):\n",
    "        return FILTERED_DATASET_ROOT\n",
    "    if RAW_DATASET_ROOT.exists() and any(RAW_DATASET_ROOT.rglob(\"*.json\")) and any(RAW_DATASET_ROOT.rglob(\"*.jpg\")):\n",
    "        return RAW_DATASET_ROOT\n",
    "    hits = [p for p in base_dir.rglob(\"hagrid-sample-30k-384p\") if p.is_dir()]\n",
    "    return hits[0] if hits else None\n",
    "\n",
    "\n",
    "registry = load_registry(REGISTRY_PATH)\n",
    "\n",
    "\n",
    "def update_registry(status: str, dataset_root: Path | None = None, archive_path: Path | None = None, auth_file: Path | None = None):\n",
    "    entry = {\n",
    "        \"kaggle_dataset\": KAGGLE_DATASET,\n",
    "        \"status\": status,\n",
    "        \"timestamp\": time.strftime(\"%Y-%m-%d %H:%M:%S\"),\n",
    "        \"archive_path\": str(archive_path) if archive_path else None,\n",
    "        \"archive_sha1\": sha1_of_file(archive_path),\n",
    "        \"dataset_root\": str(dataset_root) if dataset_root else None,\n",
    "        \"auth_file\": str(auth_file) if auth_file else None,\n",
    "        \"keep_classes\": KEEP_CLASSES,\n",
    "    }\n",
    "    registry[\"datasets\"][\"hagrid_sample_30k_384p_5class\"] = entry\n",
    "    save_registry(REGISTRY_PATH, registry)\n",
    "    return entry\n",
    "\n",
    "\n",
    "def download_dataset(auth_file: Path):\n",
    "    env = os.environ.copy()\n",
    "    env[\"KAGGLE_CONFIG_DIR\"] = str(auth_file.parent)\n",
    "\n",
    "    DATA_ROOT.mkdir(parents=True, exist_ok=True)\n",
    "    result = subprocess.run(\n",
    "        [\"kaggle\", \"datasets\", \"download\", \"-d\", KAGGLE_DATASET, \"-p\", str(DATA_ROOT), \"--force\"],\n",
    "        capture_output=True,\n",
    "        text=True,\n",
    "        env=env,\n",
    "    )\n",
    "    if result.returncode != 0:\n",
    "        print(result.stderr.strip() or result.stdout.strip())\n",
    "        raise FileNotFoundError(\"Could not download HaGRID Sample 30k 384p from Kaggle.\")\n",
    "\n",
    "    archive_candidates = sorted(DATA_ROOT.glob(\"*.zip\"), key=lambda p: p.stat().st_mtime, reverse=True)\n",
    "    if not archive_candidates:\n",
    "        raise FileNotFoundError(\"Kaggle download completed, but no archive file was found.\")\n",
    "    return archive_candidates[0]\n",
    "\n",
    "\n",
    "def extract_dataset(archive_path: Path, output_dir: Path):\n",
    "    if output_dir.exists() and any(output_dir.rglob(\"*.json\")) and any(output_dir.rglob(\"*.jpg\")):\n",
    "        return output_dir\n",
    "\n",
    "    with zipfile.ZipFile(archive_path, \"r\") as zf:\n",
    "        zf.extractall(DATA_ROOT)\n",
    "\n",
    "    extracted_root = DATA_ROOT / \"hagrid-sample-30k-384p\"\n",
    "    if extracted_root.exists():\n",
    "        return extracted_root\n",
    "    return output_dir\n",
    "\n",
    "\n",
    "def build_filtered_dataset(raw_root: Path, filtered_root: Path, classes: list[str]):\n",
    "    if filtered_root.exists():\n",
    "        shutil.rmtree(filtered_root)\n",
    "    filtered_root.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "    copied_json = []\n",
    "    copied_dirs = []\n",
    "\n",
    "    ann_src = raw_root / \"ann_train_val\"\n",
    "    ann_dst = filtered_root / \"ann_train_val\"\n",
    "    ann_dst.mkdir(parents=True, exist_ok=True)\n",
    "    for class_name in classes:\n",
    "        src = ann_src / f\"{class_name}.json\"\n",
    "        dst = ann_dst / f\"{class_name}.json\"\n",
    "        if not src.exists():\n",
    "            continue\n",
    "        shutil.copy2(src, dst)\n",
    "        copied_json.append(dst.name)\n",
    "\n",
    "    img_src = raw_root / \"hagrid_30k\"\n",
    "    img_dst = filtered_root / \"hagrid_30k\"\n",
    "    img_dst.mkdir(parents=True, exist_ok=True)\n",
    "    for class_name in classes:\n",
    "        src_dir = img_src / f\"train_val_{class_name}\"\n",
    "        dst_dir = img_dst / f\"train_val_{class_name}\"\n",
    "        if not src_dir.exists():\n",
    "            continue\n",
    "        shutil.copytree(src_dir, dst_dir)\n",
    "        copied_dirs.append(dst_dir.name)\n",
    "\n",
    "    return copied_json, copied_dirs\n",
    "\n",
    "\n",
    "def verify_dataset(root_dir: Path):\n",
    "    image_files = [p for p in root_dir.rglob(\"*.jpg\")]\n",
    "    json_files = [p for p in root_dir.rglob(\"*.json\")]\n",
    "    return {\n",
    "        \"image_count\": len(image_files),\n",
    "        \"json_count\": len(json_files),\n",
    "        \"sample_images\": [str(p) for p in image_files[:5]],\n",
    "        \"sample_jsons\": [str(p) for p in json_files[:5]],\n",
    "    }\n",
    "\n",
    "\n",
    "auth_file = detect_auth_file()\n",
    "existing_root = find_existing_dataset_root(DATA_ROOT)\n",
    "\n",
    "if existing_root is not None and FILTERED_DATASET_ROOT.exists() and any(FILTERED_DATASET_ROOT.rglob(\"*.json\")) and any(FILTERED_DATASET_ROOT.rglob(\"*.jpg\")):\n",
    "    DATASET_ROOT = FILTERED_DATASET_ROOT\n",
    "    EXTRACT_DIR = DATASET_ROOT\n",
    "    info = update_registry(\"detected_existing\", dataset_root=DATASET_ROOT, auth_file=auth_file)\n",
    "    print(\"Found existing filtered HaGRID dataset:\", DATASET_ROOT)\n",
    "elif existing_root is not None and RAW_DATASET_ROOT.exists():\n",
    "    print(\"Building filtered 5-class dataset from raw HaGRID Sample 30k 384p...\")\n",
    "    copied_json, copied_dirs = build_filtered_dataset(RAW_DATASET_ROOT, FILTERED_DATASET_ROOT, KEEP_CLASSES)\n",
    "    DATASET_ROOT = FILTERED_DATASET_ROOT\n",
    "    EXTRACT_DIR = DATASET_ROOT\n",
    "    info = update_registry(\"filtered_existing\", dataset_root=DATASET_ROOT, auth_file=auth_file)\n",
    "    print(\"Copied JSON files:\", copied_json)\n",
    "    print(\"Copied image folders:\", copied_dirs)\n",
    "else:\n",
    "    if auth_file is None:\n",
    "        info = update_registry(\"missing_auth_file\")\n",
    "        print(\"Missing Kaggle auth file.\")\n",
    "        print(\"Expected one of:\")\n",
    "        for candidate in KAGGLE_AUTH_CANDIDATES:\n",
    "            print(\" -\", candidate)\n",
    "        print(\"Place access_token.txt in .kaggle, then rerun this cell.\")\n",
    "    else:\n",
    "        ensure_kaggle_installed()\n",
    "        archive_path = download_dataset(auth_file)\n",
    "        raw_root = extract_dataset(archive_path, RAW_DATASET_ROOT)\n",
    "        copied_json, copied_dirs = build_filtered_dataset(raw_root, FILTERED_DATASET_ROOT, KEEP_CLASSES)\n",
    "        DATASET_ROOT = FILTERED_DATASET_ROOT\n",
    "        EXTRACT_DIR = DATASET_ROOT\n",
    "        info = update_registry(\"downloaded\", dataset_root=DATASET_ROOT, archive_path=archive_path, auth_file=auth_file)\n",
    "        print(\"Download + extract complete\")\n",
    "        print(\"Copied JSON files:\", copied_json)\n",
    "        print(\"Copied image folders:\", copied_dirs)\n",
    "\n",
    "verification = verify_dataset(DATASET_ROOT) if DATASET_ROOT.exists() else {\"image_count\": 0, \"json_count\": 0, \"sample_images\": [], \"sample_jsons\": []}\n",
    "print(\"Registry saved to:\", REGISTRY_PATH)\n",
    "print(json.dumps(info, indent=2))\n",
    "print(\"Verification:\")\n",
    "print(json.dumps(verification, indent=2))"
   ]
  },
